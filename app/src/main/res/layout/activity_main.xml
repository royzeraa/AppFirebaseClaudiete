
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRO DE MASCOTAS"
            android:textColor="#263B80"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa los datos de tu mascota"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <EditText
            android:id="@+id/txtCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código de mascota"
            android:inputType="text"
            android:padding="12dp" />

        <EditText
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la mascota"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de mascota"
            android:textColor="#333333"
            android:textSize="15sp"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp" />

        <EditText
            android:id="@+id/txtDueno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del dueño"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <EditText
            android:id="@+id/txtDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENVIAR DATOS"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnCargar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CARGAR DATOS"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MASCOTAS REGISTRADAS"
            android:textColor="#263B80"
            android:textStyle="bold"
            android:textSize="19sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="10dp" />

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#CCCCCC"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>
